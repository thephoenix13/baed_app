{
  "rewrites": [{ "source": "/((?!assets/|icons/|photos/|sw\.js|workbox-.*|manifest\.webmanifest).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(assets|photos|icons)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
